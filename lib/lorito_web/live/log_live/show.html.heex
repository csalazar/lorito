<.header>
  Log {@log.id}
  <:subtitle>This is a log record from your database.</:subtitle>
  <:actions></:actions>
</.header>

<.list>
  <!-- TODO: remove the condition when all instances have new logs !-->
  <:item :if={@log.project} title="Project">
    <.link navigate={~p"/_lorito/projects/#{@log.project}/workspaces"}>
      {@log.project.name}
      <.icon name="hero-link" />
    </.link>
  </:item>
  <:item title="Workspace">
    <%= if @log.workspace do %>
      <.link navigate={~p"/_lorito/projects/#{@log.project}/workspaces/#{@log.workspace}"}>
        {@log.workspace.displayable_name}
        <.icon name="hero-link" />
      </.link>
    <% else %>
      catch-all
    <% end %>
  </:item>
</.list>

<.list :if={@protocol == :http}>
  <:item title="IP">{@log.ip}</:item>
  <:item title="Method">{@log.method}</:item>
  <:item title="Url"><span class="whitespace-normal break-all">{@log.url}</span></:item>
  <:item :if={@log.error} title="Capture error" error_status={true}>{@log.error}</:item>
  <:item title="Headers">
    <span :if={@log.headers == []}>-</span>
    <table :if={@log.headers != []} class="table w-full">
      <thead>
        <tr>
          <th>Name</th>
          <th>Value</th>
        </tr>
      </thead>
      <tbody>
        <%= for [header, value] <- @log.headers do %>
          <tr>
            <td><b>{header}</b></td>
            <td class="whitespace-normal break-all">
              {value}
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </:item>
  <:item :if={Enum.count(@log.params) > 0} title="Params">
    <table class="table w-full">
      <thead>
        <tr>
          <th>Name</th>
          <th>Value</th>
        </tr>
      </thead>
      <tbody>
        <%= for {name, value} <- @log.params do %>
          <tr>
            <td><b>{name}</b></td>
            <td class="whitespace-normal break-all">
              <%= case {name, value} do %>
                <% {"screenshot", value} when is_binary(value) -> %>
                  <%= if String.starts_with?(value, "data:image/") do %>
                    <img src={value} />
                  <% else %>
                    Invalid image format: {value}
                  <% end %>
                <% _ -> %>
                  {if is_binary(value), do: value, else: Jason.encode!(value)}
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </:item>
  <:item title="Body size">
    <span id="body-size" title={"#{@body_size} bytes"}>{LoritoWeb.Utils.format_bytes(@body_size)}</span>
  </:item>
  <:item :if={@recovered_files != []} title="Uploaded files">
    <div :for={file <- @recovered_files} class="mb-2 whitespace-normal break-all">
      <span>{file.filename} ({file.field}) — {LoritoWeb.Utils.format_bytes(file.size)} — {file.content_type}</span>
      <.link href={~p"/_lorito/logs/#{@log.id}/uploads/#{file.index}"} class="btn btn-sm ml-2">
        Download file
      </.link>
    </div>
  </:item>
  <:item
    title="Body"
    badges={
      Enum.reject(
        [if(@body_truncated, do: "Preview"), if(@log.body_encoding == "base64", do: "Base64")],
        &is_nil/1
      )
    }
  >
    <span :if={@body_size == 0}>-</span>
    <div :if={@body_size > 0} class="min-w-0 w-full">
      <pre
        id="body-preview"
        class="max-h-96 overflow-auto whitespace-pre-wrap break-all rounded bg-base-200 p-3 text-xs"
      >{@body_preview}</pre>
      <.link
        :if={@body_truncated}
        id="download-full-body"
        href={~p"/_lorito/logs/#{@log.id}/body"}
        class="btn btn-sm mt-3"
      >
        Download full body
      </.link>
    </div>
  </:item>
</.list>
<.list :if={@protocol == :dns}>
  <:item title="IP">{@log.ip}</:item>
  <:item title="Record type">{@log.record_type}</:item>
  <:item title="Query domain">{@log.query_name}</:item>
</.list>
<%= case @live_action do %>
  <% :log_show-> %>
    <.back navigate={~p"/_lorito/logs"}>Back to logs</.back>
  <% :workspace_log_show -> %>
    <.back navigate={~p"/_lorito/projects/#{@log.project}/workspaces/#{@log.workspace}"}>
      Back to workspace
    </.back>
<% end %>
